   "outputs": [],
   "source": [
    "def func(L):\n",
    "    if not L:\n",
    "        return \"\"\n",
    "\n",
    "    L.sort()\n",
    "    \n",
    "    first = L[0]\n",
    "    last = L[-1]\n",
    "    \n",
    "    i = 0\n",
    "    while i < len(first) and first[i] == last[i]:\n",
    "        i += 1\n",
    "    \n",
    "    return first[:i]"
   ]
  },
